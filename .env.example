
# S_Cart Django Environment Configuration Example

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration
# Set DB_ENGINE=postgres to use PostgreSQL, or DB_ENGINE=sqlite to use SQLite
DB_ENGINE=sqlite

DB_NAME=scart_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
